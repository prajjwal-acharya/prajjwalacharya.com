# Analytics is off by default — nothing loads unless you set
# NEXT_PUBLIC_ANALYTICS_PROVIDER. Pick exactly one block below and fill
# in your own ID/token/domain; nothing here is a real value.
# NEXT_PUBLIC_* vars are baked in at build time (this is a static site,
# not a runtime secret).

# --- Plausible ---
# NEXT_PUBLIC_ANALYTICS_PROVIDER=plausible
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=prajjwalacharya.com
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/script.js

# --- Google Analytics (GA4) ---
# NEXT_PUBLIC_ANALYTICS_PROVIDER=google
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Cloudflare Web Analytics ---
# NEXT_PUBLIC_ANALYTICS_PROVIDER=cloudflare
# NEXT_PUBLIC_CLOUDFLARE_BEACON_TOKEN=your-beacon-token
