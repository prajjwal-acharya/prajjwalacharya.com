{
  "name": "prajjwalacharya.com",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=20"
  },
  "imports": {
    "#velite": "./.velite/index.js"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "content:build": "velite build",
    "pretypecheck": "velite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pages:build": "opennextjs-cloudflare build",
    "pages:preview": "opennextjs-cloudflare preview",
    "pages:deploy": "opennextjs-cloudflare deploy",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "next": "15.5.20",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "velite": "0.4.0",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "class-variance-authority": "0.7.1",
    "lucide-react": "1.25.0",
    "@radix-ui/react-slot": "1.3.0",
    "rehype-pretty-code": "0.14.4",
    "shiki": "4.3.1",
    "rehype-slug": "6.0.0",
    "image-size": "2.0.2",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@eslint/eslintrc": "3.3.6",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "@types/node": "22.10.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.20",
    "prettier": "3.9.5",
    "prettier-plugin-tailwindcss": "0.8.1",
    "@opennextjs/cloudflare": "1.20.1",
    "wrangler": "4.112.0"
  }
}
