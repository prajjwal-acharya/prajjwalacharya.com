{
  "name": "prajjwalacharya.com",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=22"
  },
  "imports": {
    "#velite": "./.velite/index.js"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "content:build": "velite build",
    "generate:mdx-registry": "node scripts/generate-mdx-registry.mjs",
    "pretypecheck": "velite build && pnpm generate:mdx-registry",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pages:build": "opennextjs-cloudflare build",
    "pages:preview": "opennextjs-cloudflare preview",
    "pages:deploy": "opennextjs-cloudflare deploy",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build",
    "prepare": "husky"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@next/mdx": "^16.2.12",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "image-size": "2.0.2",
    "lucide-react": "1.27.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-pretty-code": "0.14.5",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "4.3.1",
    "tailwind-merge": "3.6.0",
    "unist-util-visit": "5.1.0",
    "velite": "0.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@opennextjs/cloudflare": "1.20.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.8.0",
    "eslint-config-next": "16.2.12",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "wrangler": "4.115.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,mdx,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
